@page "/items/new"
@page "/items/{ItemId:guid}"
@inject ArchiveApiClient ArchiveClient
@inject NavigationManager Navigation

<PageTitle>@(_isNew ? "Nova obra" : "Editar obra") | MyArchive</PageTitle>

@if (_loading)
{
    <section class="panel-card">
        <p class="empty-copy">Carregando editor...</p>
    </section>
}
else if (_notFound)
{
    <section class="panel-card">
        <p class="empty-copy">Item nao encontrado.</p>
        <a class="button-link" href="/items">Voltar ao acervo</a>
    </section>
}
else
{
    <section class="page-header">
        <div>
            <p class="section-kicker">@(_isNew ? "Cadastro" : "Edicao")</p>
            <h1>@(_isNew ? "Registrar uma nova obra." : $"Ajustar {Model.Title}.")</h1>
            <p class="hero-copy">Cada categoria usa status proprios e o cadastro prioriza capa, avaliacao, resenha e observacoes.</p>
        </div>
    </section>

    <EditForm Model="Model" OnValidSubmit="SaveAsync" class="editor-stack">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <section class="panel-card form-grid">
            <label>
                <span>Categoria</span>
                <select class="input-field" value="@Model.Category" @onchange="HandleCategoryChanged">
                    @foreach (var category in ArchiveMetadata.Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </label>

            <label>
                <span>Status</span>
                <InputSelect class="input-field" @bind-Value="Model.Status">
                    @foreach (var status in ArchiveMetadata.GetStatuses(Model.Category))
                    {
                        <option value="@status">@status</option>
                    }
                </InputSelect>
            </label>

            <label class="full-span">
                <span>Titulo</span>
                <InputText class="input-field" @bind-Value="Model.Title" />
            </label>

            <label class="full-span">
                <span>URL da capa</span>
                <InputText class="input-field" @bind-Value="Model.CoverImageUrl" placeholder="https://..." />
            </label>

            <div class="cover-preview-shell full-span">
                <img class="cover-preview" src="@Model.CoverImageUrl" alt="Previa da capa de @Model.Title" />
            </div>

            <label>
                <span>Nota</span>
                <InputNumber TValue="double?" class="input-field" @bind-Value="Model.Rating" />
            </label>

            <label>
                <span>Criado em</span>
                <InputDate class="input-field" @bind-Value="Model.CreatedAt" />
            </label>

            <label>
                <span>Concluido em</span>
                <InputDate class="input-field" @bind-Value="Model.CompletedAt" />
            </label>

            <label class="full-span">
                <span>Resenha</span>
                <InputTextArea class="input-field tall-field" @bind-Value="Model.Review" />
            </label>

            <label class="full-span">
                <span>Observacoes</span>
                <InputTextArea class="input-field tall-field" @bind-Value="Model.Notes" />
            </label>

            <label class="full-span">
                <span>Tags auxiliares</span>
                <InputText class="input-field" @bind-Value="Model.TagsText" placeholder="Opcional" />
            </label>
        </section>

        @if (ArchiveMetadata.IsGameCategory(Model.Category))
        {
            <section class="panel-card form-grid">
                <div class="full-span">
                    <p class="section-kicker">Games</p>
                    <h2>Detalhes da versao</h2>
                </div>

                <label>
                    <span>Midia</span>
                    <InputSelect class="input-field" @bind-Value="Model.GameMedia">
                        <option value="">Selecione</option>
                        @foreach (var media in ArchiveMetadata.GameMediaOptions)
                        {
                            <option value="@media">@media</option>
                        }
                    </InputSelect>
                </label>

                <label>
                    <span>Plataforma</span>
                    <InputSelect class="input-field" @bind-Value="Model.GamePlatform">
                        <option value="">Selecione</option>
                        @foreach (var platform in ArchiveMetadata.GamePlatformOptions)
                        {
                            <option value="@platform">@platform</option>
                        }
                    </InputSelect>
                </label>

                <label class="toggle-field full-span">
                    <InputCheckbox class="form-check-input" @bind-Value="Model.FinishedOnAnotherPlatform" />
                    <span>Finalizado em outra plataforma</span>
                </label>
            </section>
        }

        <div class="toolbar-actions">
            <button type="submit" class="button-link">Salvar obra</button>
            <a class="button-link muted" href="/items">Cancelar</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? ItemId { get; set; }

    private ItemEditorModel Model { get; set; } = new();
    private bool _loading = true;
    private bool _notFound;
    private bool _isNew => !ItemId.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _notFound = false;

        if (_isNew)
        {
            Model = ArchiveApiClient.CreateNewItem();
        }
        else if (ItemId is Guid itemId)
        {
            var existing = await ArchiveClient.GetItemAsync(itemId);
            if (existing is null)
            {
                _notFound = true;
            }
            else
            {
                Model = existing;
                EnsureValidStatus();
            }
        }
        else
        {
            _notFound = true;
        }

        _loading = false;
    }

    private void HandleCategoryChanged(ChangeEventArgs args)
    {
        Model.Category = args.Value?.ToString() ?? ArchiveMetadata.Categories.First();
        EnsureValidStatus();

        if (!ArchiveMetadata.IsGameCategory(Model.Category))
        {
            Model.GameMedia = string.Empty;
            Model.GamePlatform = string.Empty;
            Model.FinishedOnAnotherPlatform = false;
        }
    }

    private void EnsureValidStatus()
    {
        Model.Category = ArchiveMetadata.NormalizeCategory(Model.Category);
        Model.Status = ArchiveMetadata.NormalizeStatus(Model.Category, Model.Status);
    }

    private async Task SaveAsync()
    {
        EnsureValidStatus();
        var saved = await ArchiveClient.SaveItemAsync(Model);
        Navigation.NavigateTo($"/items/{saved.Id}");
    }
}
