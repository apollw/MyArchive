@page "/"
@inject ArchiveApiClient ArchiveClient

<PageTitle>Dashboard | MyArchive</PageTitle>

@if (_dashboard is null)
{
    <section class="hero-panel">
        <p class="section-kicker">Carregando</p>
        <h1>Montando a biblioteca do seu acervo.</h1>
    </section>
}
else
{
    <section class="hero-panel">
        <div>
            <p class="section-kicker">Dashboard</p>
            <h1>Uma biblioteca pessoal pensada para obras, nao para tarefas.</h1>
            <p class="hero-copy">
                Cadastre capas, acompanhe status por categoria, registre notas e mantenha uma visao
                clara do que foi lido, assistido ou finalizado.
            </p>
        </div>

        <div class="hero-actions">
            <a class="button-link" href="/items/new">Cadastrar obra</a>
            <a class="button-link muted" href="/items">Abrir acervo</a>
        </div>
    </section>

    <section class="metric-grid">
        @foreach (var metric in _dashboard.Metrics)
        {
            <article class="metric-card @metric.Accent">
                <span>@metric.Label</span>
                <strong>@metric.Value</strong>
            </article>
        }
    </section>

    <section class="dashboard-grid">
        <article class="panel-card">
            <div class="panel-heading">
                <div>
                    <p class="section-kicker">Recem adicionados</p>
                    <h2>Ultimos registros</h2>
                </div>
            </div>

            @if (_dashboard.LatestItems.Count == 0)
            {
                <p class="empty-copy">Nenhum item cadastrado ainda.</p>
            }
            else
            {
                <div class="stack-list">
                    @foreach (var item in _dashboard.LatestItems)
                    {
                        <article class="media-row">
                            <img class="media-thumb" src="@GetCoverSource(item)" alt="Capa de @item.Title" />
                            <div>
                                <div class="item-header">
                                    <strong>@item.Title</strong>
                                    <span class="pill @ArchiveMetadata.GetStatusCssClass(item.Status)">@item.Status</span>
                                </div>
                                <p>@item.Category</p>
                                <small>@item.CreatedAt.ToString("dd/MM/yyyy")</small>
                            </div>
                        </article>
                    }
                </div>
            }
        </article>

        <article class="panel-card">
            <div class="panel-heading">
                <div>
                    <p class="section-kicker">Em andamento</p>
                    <h2>Consumindo agora</h2>
                </div>
            </div>

            @if (_dashboard.ActiveItems.Count == 0)
            {
                <p class="empty-copy">Nenhuma obra em andamento no momento.</p>
            }
            else
            {
                <div class="stack-list">
                    @foreach (var item in _dashboard.ActiveItems)
                    {
                        <article class="media-row">
                            <img class="media-thumb" src="@GetCoverSource(item)" alt="Capa de @item.Title" />
                            <div>
                                <div class="item-header">
                                    <strong>@item.Title</strong>
                                    @if (item.Rating.HasValue)
                                    {
                                        <span class="pill rating-pill">@item.Rating.Value.ToString("0.##")</span>
                                    }
                                </div>
                                <p>@item.Category · @item.Status</p>
                                <small>@GetGameLine(item)</small>
                            </div>
                        </article>
                    }
                </div>
            }
        </article>

        <article class="panel-card">
            <div class="panel-heading">
                <div>
                    <p class="section-kicker">Concluidos</p>
                    <h2>Historico recente</h2>
                </div>
            </div>

            @if (_dashboard.RecentlyCompleted.Count == 0)
            {
                <p class="empty-copy">Ainda nao existem conclusoes registradas.</p>
            }
            else
            {
                <div class="stack-list">
                    @foreach (var item in _dashboard.RecentlyCompleted)
                    {
                        <article class="media-row">
                            <img class="media-thumb" src="@GetCoverSource(item)" alt="Capa de @item.Title" />
                            <div>
                                <strong>@item.Title</strong>
                                <p>@item.Category · @item.Status</p>
                                <small>@(item.CompletedAt?.ToString("dd/MM/yyyy") ?? "-")</small>
                            </div>
                        </article>
                    }
                </div>
            }
        </article>

        <article class="panel-card">
            <div class="panel-heading">
                <div>
                    <p class="section-kicker">Categorias</p>
                    <h2>Distribuicao do acervo</h2>
                </div>
            </div>

            <div class="type-grid">
                @foreach (var point in _dashboard.CategoryBreakdown.Where(point => point.Value > 0))
                {
                    <article class="type-card">
                        <span>@point.Label</span>
                        <strong>@point.Value</strong>
                    </article>
                }
            </div>
        </article>

        <article class="panel-card wide">
            <div class="panel-heading">
                <div>
                    <p class="section-kicker">Status</p>
                    <h2>Panorama por andamento</h2>
                </div>
            </div>

            <div class="chart-list">
                @foreach (var point in _dashboard.StatusBreakdown)
                {
                    <div class="chart-row">
                        <span>@point.Label</span>
                        <div class="chart-track">
                            <div class="chart-bar" style="@($"width: {GetRatio(point.Value, _dashboard.StatusBreakdown)}%;")"></div>
                        </div>
                        <strong>@point.Value</strong>
                    </div>
                }
            </div>
        </article>
    </section>
}

@code {
    private DashboardSummary? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        _dashboard = await ArchiveClient.GetDashboardAsync();
    }

    private static string GetCoverSource(ArchiveListItemSummary item)
    {
        if (!string.IsNullOrWhiteSpace(item.CoverThumbnailUrl))
        {
            return item.CoverThumbnailUrl;
        }

        return string.IsNullOrWhiteSpace(item.CoverImageUrl) ? ArchiveMetadata.DefaultCoverPath : item.CoverImageUrl;
    }

    private static string GetGameLine(ArchiveListItemSummary item)
    {
        if (!ArchiveMetadata.IsGameCategory(item.Category))
        {
            return item.Review.Length > 72 ? $"{item.Review[..72]}..." : item.Review;
        }

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(item.GamePlatform))
        {
            parts.Add(item.GamePlatform);
        }

        if (!string.IsNullOrWhiteSpace(item.GameMedia))
        {
            parts.Add(item.GameMedia);
        }

        if (item.FinishedOnAnotherPlatform)
        {
            parts.Add("Finalizado em outra plataforma");
        }

        return parts.Count == 0 ? "Sem detalhes adicionais." : string.Join(" · ", parts);
    }

    private static double GetRatio(int value, IReadOnlyList<DashboardTimelinePoint> points)
    {
        var max = Math.Max(1, points.Max(point => point.Value));
        return value * 100d / max;
    }
}