@page "/items"
@inject ArchiveApiClient ArchiveClient

<PageTitle>Acervo | MyArchive</PageTitle>

<section class="page-header">
    <div>
        <p class="section-kicker">Acervo</p>
        <h1>Uma estante visual para tudo o que voce le, assiste e joga.</h1>
        <p class="hero-copy">Filtre por categoria e status, com capas em destaque e informacoes rapidas de cada obra.</p>
    </div>

    <a class="button-link" href="/items/new">Nova obra</a>
</section>

<section class="panel-card filter-panel">
    <div class="filter-grid">
        <label class="full-span">
            <span>Busca</span>
            <InputText class="input-field" @bind-Value="_query.Search" placeholder="Titulo, resenha, observacao ou categoria" />
        </label>

        <label>
            <span>Categoria</span>
            <select class="input-field" value="@_query.Category" @onchange="HandleCategoryFilterChanged">
                <option value="">Todas</option>
                @foreach (var category in GetCategoryOptions())
                {
                    <option value="@category">@category</option>
                }
            </select>
        </label>

        <label>
            <span>Status</span>
            <select class="input-field" value="@_query.Status" @onchange="HandleStatusFilterChanged">
                <option value="">Todos</option>
                @foreach (var status in GetStatusOptions())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </label>

        <label>
            <span>Agrupar por</span>
            <InputSelect class="input-field" @bind-Value="_query.GroupBy">
                <option value="@ArchiveGroupBy.Category">Categoria</option>
                <option value="@ArchiveGroupBy.Status">Status</option>
                <option value="@ArchiveGroupBy.None">Sem agrupamento</option>
            </InputSelect>
        </label>
    </div>

    <div class="toolbar-actions">
        <button type="button" class="button-link" @onclick="LoadAsync">Aplicar filtros</button>
        <button type="button" class="button-link muted" @onclick="ResetFiltersAsync">Limpar</button>
    </div>
</section>

@if (_catalog is null)
{
    <section class="panel-card">
        <p class="empty-copy">Carregando itens...</p>
    </section>
}
else if (_catalog.Items.Count == 0)
{
    <section class="panel-card">
        <p class="empty-copy">Nenhuma obra encontrada com os filtros atuais.</p>
    </section>
}
else
{
    <section class="group-stack">
        @foreach (var group in _catalog.Groups)
        {
            <article class="panel-card">
                <div class="panel-heading">
                    <div>
                        <p class="section-kicker">Agrupamento</p>
                        <h2>@group.Title</h2>
                    </div>
                    <span class="count-chip">@group.Items.Count obra(s)</span>
                </div>

                <div class="catalog-grid">
                    @foreach (var item in group.Items)
                    {
                        <article class="catalog-card library-card">
                            <img class="catalog-cover" src="@item.CoverImageUrl" alt="Capa de @item.Title" />

                            <div class="catalog-body">
                                <div class="item-header">
                                    <strong>@item.Title</strong>
                                    @if (item.Rating.HasValue)
                                    {
                                        <span class="pill rating-pill">@item.Rating.Value.ToString("0.##")</span>
                                    }
                                </div>

                                <p class="card-meta">
                                    @item.Category · <span class="pill @ArchiveMetadata.GetStatusCssClass(item.Status)">@item.Status</span>
                                </p>

                                <p class="card-copy">@GetReviewExcerpt(item)</p>

                                @if (ArchiveMetadata.IsGameCategory(item.Category))
                                {
                                    <p class="detail-copy">@GetGameDetails(item)</p>
                                }

                                @if (ArchiveMetadata.IsTrackableUnitCategory(item.Category) && item.EpisodeCount > 0)
                                {
                                    <div class="episode-progress">
                                        <div class="episode-progress-line">
                                            <span>@item.CompletedEpisodeCount/@item.EpisodeCount @GetUnitProgressLabel(item)</span>
                                            <span>@GetEpisodeProgressPercent(item)%</span>
                                        </div>
                                        <div class="episode-progress-track">
                                            <span style="@GetEpisodeProgressStyle(item)"></span>
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <p class="detail-copy">@GetNotesExcerpt(item.Notes)</p>
                                }

                                <div class="card-actions">
                                    <a class="inline-link" href="/items/@item.Id">Editar</a>
                                    @if (_pendingDeleteId == item.Id)
                                    {
                                        <button type="button" class="inline-button danger" @onclick="() => DeleteAsync(item.Id)">Confirmar exclusao</button>
                                        <button type="button" class="inline-button" @onclick="ClearPendingDelete">Cancelar</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="inline-button" @onclick="() => SetPendingDelete(item.Id)">Excluir</button>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </article>
        }
    </section>
}

@code {
    private readonly ArchiveQuery _query = new();
    private ArchiveCatalog? _catalog;
    private Guid? _pendingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _catalog = await ArchiveClient.GetCatalogAsync(_query);
        _pendingDeleteId = null;
        SyncStatusFilter();
    }

    private async Task ResetFiltersAsync()
    {
        _query.Search = string.Empty;
        _query.Category = string.Empty;
        _query.Status = string.Empty;
        _query.GroupBy = ArchiveGroupBy.Category;
        await LoadAsync();
    }

    private void SetPendingDelete(Guid id) => _pendingDeleteId = id;

    private void ClearPendingDelete() => _pendingDeleteId = null;

    private async Task DeleteAsync(Guid id)
    {
        await ArchiveClient.DeleteItemAsync(id);
        await LoadAsync();
    }

    private static IReadOnlyList<string> GetCategoryOptions()
        => ArchiveMetadata.Categories;

    private IReadOnlyList<string> GetStatusOptions()
    {
        if (!string.IsNullOrWhiteSpace(_query.Category))
        {
            return ArchiveMetadata.GetStatuses(_query.Category);
        }

        return ArchiveMetadata.Categories
            .SelectMany(category => ArchiveMetadata.GetStatuses(category))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order()
            .ToList();
    }

    private void SyncStatusFilter()
    {
        if (string.IsNullOrWhiteSpace(_query.Status))
        {
            return;
        }

        var allowedStatuses = GetStatusOptions();
        if (!allowedStatuses.Contains(_query.Status, StringComparer.OrdinalIgnoreCase))
        {
            _query.Status = string.Empty;
        }
    }

    private void HandleCategoryFilterChanged(ChangeEventArgs args)
    {
        _query.Category = args.Value?.ToString() ?? string.Empty;
        SyncStatusFilter();
    }

    private void HandleStatusFilterChanged(ChangeEventArgs args)
    {
        _query.Status = args.Value?.ToString() ?? string.Empty;
    }

    private static string GetReviewExcerpt(ArchiveListItemSummary item)
    {
        var content = string.IsNullOrWhiteSpace(item.Review) ? "Sem resenha registrada." : item.Review;
        return content.Length > 150 ? $"{content[..150]}..." : content;
    }

    private static string GetNotesExcerpt(string notes)
        => notes.Length > 110 ? $"{notes[..110]}..." : notes;

    private static string GetUnitProgressLabel(ArchiveListItemSummary item)
    {
        var unitPlural = ArchiveMetadata.GetUnitPlural(item.Category);
        var action = ArchiveMetadata.IsEpisodicCategory(item.Category) ? "vistos" : "lidos";
        return $"{unitPlural} {action}";
    }

    private static int GetEpisodeProgressPercent(ArchiveListItemSummary item)
        => item.EpisodeCount == 0 ? 0 : (int)Math.Round(item.CompletedEpisodeCount * 100d / item.EpisodeCount);

    private static string GetEpisodeProgressStyle(ArchiveListItemSummary item)
        => $"width: {GetEpisodeProgressPercent(item)}%;";

    private static string GetGameDetails(ArchiveListItemSummary item)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(item.GamePlatform))
        {
            parts.Add(item.GamePlatform);
        }

        if (!string.IsNullOrWhiteSpace(item.GameMedia))
        {
            parts.Add(item.GameMedia);
        }

        if (item.FinishedOnAnotherPlatform)
        {
            parts.Add("Finalizado em outra plataforma");
        }

        return parts.Count == 0 ? "Sem detalhes adicionais para esta versao." : string.Join(" · ", parts);
    }
}
