@inherits LayoutComponentBase

<div class="shell">
    <aside class="sidebar-shell">
        <NavMenu />
    </aside>

    <main class="workspace">
        <header class="topbar">
            <div>
                <p class="eyebrow">Biblioteca pessoal digital</p>
                <p class="topbar-copy">Catalogo visual com Blazor WebAssembly no cliente, API ASP.NET Core no backend e persistencia em PostgreSQL.</p>
            </div>

            <a class="button-link" href="/items/new">Novo registro</a>
        </header>

        <article class="content-area">
            @Body
        </article>
    </main>
</div>
